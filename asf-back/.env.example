# Copiar para .env (desenvolvimento local). O .env nunca vai para o Git.
# Em produção estes valores ficam no wrangler.toml (vars), não no painel da Cloudflare.

# URL do projeto Supabase (Project Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (publishable). É pública por definição: a RLS é quem protege o dado.
# Nunca colocar aqui a secret key nem a service_role.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

PORT=3001

# Endereço do front (links de recuperação de senha)
FRONT_URL=http://localhost:3000
