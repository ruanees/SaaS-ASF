        "server-only": "^0.0.1"
    },
    "devDependencies": {
        "@opennextjs/cloudflare": "^1.20.12",
        "@types/node": "^24.19.2",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^10",
        "eslint-config-next": "16.4.2",
        "openapi-typescript": "^7.13.0",
        "typescript": "^5",
        "vitest": "^4.1.12",
        "wrangler": "^4.151.1"
    }
